#!/bin/sh

# Pin Erlang distribution to a small port range for firewall rules.
# EPMD listens on 4369. The RUNNING node grabs ERL_DIST_PORT. The
# range gives short-lived hidden nodes (bin/console rpc, remote_console,
# eval) room to bind their own port without colliding with the running
# node. Otherwise `bin/console rpc` fails with:
#   Protocol 'inet_tls': register/listen error: eaddrinuse
#
# Respects an external ERL_DIST_PORT (set by systemd EnvironmentFile
# on co-tenanted hosts where another BEAM release already holds 9100).
# Default range width is 10 → 11 ports total; the running node uses
# the base, hidden nodes pick from the rest.
#
# Only the base port needs a firewall rule for peer traffic; the extra
# ports are for local console spawns and never cross the network.
export ERL_DIST_PORT="${ERL_DIST_PORT:-9100}"
export ERL_DIST_PORT_RANGE="${ERL_DIST_PORT_RANGE:-10}"
export ERL_FLAGS="-kernel inet_dist_listen_min $ERL_DIST_PORT -kernel inet_dist_listen_max $((ERL_DIST_PORT + ERL_DIST_PORT_RANGE)) ${ERL_FLAGS:-}"
